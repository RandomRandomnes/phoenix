#!/bin/bash
# Run by the update button in the Hyprland top bar (UpdatesCount.qml, inside kitty) and by the KDE panel
# widget (~/.local/share/plasma/plasmoids/org.kde.plasma.systemupdate, inside Konsole).
# 0) restore point (~/.local/bin/restore-point)  1) system packages via yay  2) system fixes for the new versions
# (always)  3) Phoenix updates, which include the shell (if enabled). Since 2026-10-09 the shell no longer follows
# upstream illogical-impulse: it comes only with Phoenix releases (custom-update), so there is no separate shell step.
# Two ways to run (2026-10-15), asked once on the first update after installing and kept in config.json
# extras.updateMode (Settings › Update › "How updates install" changes it):
#   ask  = like the installer: yay shows what will be updated (and AUR build files) and asks before installing;
#          Phoenix updates show their notes and ask
#   auto = unattended apart from the sudo password at the start
# The window closes by itself on success and stays open on failure.
# --gui (2026-10-16): run by the shell without a terminal (Settings › Update, the taskbar's update button):
#   no questions in the window; sudo asks in the shell's own password dialog (SUDO_ASKPASS=phoenix-askpass), only when
#   there really are package updates; progress as "@@step <name>" lines, the summary as "@@msg <text>", plus
#   "@@relogin" / "@@reboot" hints; exit 3 = update mode not chosen yet (the shell asks), 4 = stopped for critical
#   updates on the publishing PC. "Ask first" mode stays in a terminal (you review yay's list there).
gui=0; [ "${1:-}" = --gui ] && gui=1
step() { [ $gui -eq 1 ] && echo "@@step $1"; echo -e "\e[1m==> $1\e[0m"; }
CONFIG="$HOME/.config/illogical-impulse/config.json"
update_mode() { python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("extras", {}).get("updateMode", ""))
except Exception: print("")' "$CONFIG"; }
set_update_mode() {
    # through the running shell when there is one (it owns config.json; 2026-10-16), else straight into the file
    qs -c end4-pC ipc call config set extras.updateMode "$1" >/dev/null 2>&1 && return 0
    python3 -c 'import json,os,sys
p=sys.argv[1]; c=json.load(open(p)); c.setdefault("extras", {})["updateMode"]=sys.argv[2]
t=p+".tmp"; json.dump(c, open(t, "w"), indent=4); os.replace(t, p)' "$CONFIG" "$1"; }

mode=$(update_mode)
if [ $gui -eq 1 ] && [ "$mode" != ask ] && [ "$mode" != auto ]; then
    echo "@@needmode"; exit 3
fi
if [ "$mode" != ask ] && [ "$mode" != auto ]; then
    if [ -t 0 ]; then
        # first update after installing: ask once, like the installer does
        echo -e "\e[1m==> How should updates install?\e[0m"
        echo "  1) Show me what will be updated and ask before installing (like the installer)"
        echo "  2) Install everything automatically (only asks for your password)"
        echo "You can change this later in Settings › Update."
        read -r -p "Choose 1 or 2 [1]: " a
        [ "$a" = 2 ] && mode=auto || mode=ask
        set_update_mode "$mode" && echo "Saved: $( [ $mode = ask ] && echo 'ask before installing' || echo 'install automatically' )." \
            || echo "Couldn't save the choice; asking again next time."
        echo
    else
        mode=auto   # no terminal to answer in: keep the old behaviour and ask next time
    fi
fi

hypr_before=$(pacman -Q hyprland 2>/dev/null)
kernel_before=$(pacman -Q linux 2>/dev/null)
plasma_before=$(pacman -Q plasma-workspace 2>/dev/null)
pgrep -f '^qs -c [e]nd4-pC$' >/dev/null && in_hypr=1 || in_hypr=0

# critical updates first (~/.local/bin/phoenix-check, 2026-10-09): a new Qt or Hyprland version, Quickshell, graphics
# drivers. Shown on every PC; on the PC that publishes Phoenix the update stops to ask, so they can be tried in the
# test VM first (and a system fix prepared) before they reach this desktop and everyone else's.
if [ -x "$HOME/.local/bin/phoenix-check" ]; then
    step "Critical updates"
    "$HOME/.local/bin/phoenix-check" updates --fresh
    crit=$?
    if [ $gui -eq 1 ] && [ $crit -ne 0 ] && [ -d "$HOME/.local/state/custom-fixes-publisher" ]; then
        echo "@@msg This PC publishes Phoenix: try these critical updates in the test VM first, then update from a terminal (system-update)."
        echo "@@stop critical"; exit 4
    fi
    if [ $crit -ne 0 ] && [ -d "$HOME/.local/state/custom-fixes-publisher" ] && [ -r /dev/tty ]; then
        echo
        echo "This PC publishes Phoenix: try these in the test VM first (~/clone-usb/vm/vmlab.sh start plain, then update there)."
        read -r -p "Install everything now anyway? [y/N] " a < /dev/tty
        if [[ ! "$a" =~ ^[yY] ]]; then
            echo "Nothing was installed."
            read -r -p "Press Enter to close." < /dev/tty
            exit 0
        fi
    fi
    echo
fi

# 0) a restore point: settings + package versions, so Settings › Update › Restore points can undo this update
step "Restore point"
if "$HOME/.local/bin/restore-point" create --reason "Before update" >/dev/null; then
    echo "Saved. Settings › Update › Restore points can undo this update."
else
    echo "Couldn't save a restore point; the update continues."
fi
echo

step "System packages"
# --sudoloop: keep sudo alive through long AUR builds so the password is only asked once.
# pacman-contrib (checkupdates: the taskbar's update count and the critical-update check) is added when missing;
# the installer didn't install it before 2026-10-15.
extra=(); pacman -Q pacman-contrib >/dev/null 2>&1 || extra=(--needed pacman-contrib)
# nothing to update: skip yay (and its password prompt) entirely; Phoenix-only updates need no admin rights
pending=-1
if command -v checkupdates >/dev/null && [ ${#extra[@]} -eq 0 ]; then
    pending=$(( $(checkupdates 2>/dev/null | wc -l) + $(yay -Qua 2>/dev/null | wc -l) ))
fi
if [ $pending -eq 0 ]; then
    echo "Already up to date."
    true
elif [ $gui -eq 1 ]; then
    # no terminal: sudo asks in the shell's password dialog; --sudoloop keeps it to one question
    export SUDO_ASKPASS="$HOME/.local/bin/phoenix-askpass"
    export PHOENIX_ASKPASS_MESSAGE="Enter your password to install the system updates"
    yay -Syu --combinedupgrade=false --noconfirm --sudoloop --sudoflags "-A" \
        --answerclean None --answerdiff None --answeredit None --removemake "${extra[@]}" </dev/null
elif [ "$mode" = ask ]; then
    # yay lists every package with old → new version, offers to show the AUR build files, and asks before installing
    echo "Review the list below; nothing is installed until you confirm."
    yay -Syu --combinedupgrade=false --sudoloop --removemake "${extra[@]}"
else
    # --noconfirm: accept pacman's default answers. --answer*: skip yay's clean/diff/edit review menus.
    yay -Syu --combinedupgrade=false --noconfirm --sudoloop \
        --answerclean None --answerdiff None --answeredit None --removemake "${extra[@]}"
fi
yay_rc=$?

# 2) system fixes: always, right after the packages and the shell they belong to (only those matching the installed
#    versions install; see ~/.local/bin/custom-update)
echo
step "System fixes"
"$HOME/.local/bin/custom-update" system-apply
sysfix_rc=$?

# 3) Phoenix updates: fixes and the shell (only when enabled)
fixes_rc=0
if grep -q '"customFixes": *true' "$HOME/.config/illogical-impulse/config.json" 2>/dev/null; then
    echo
    step "Phoenix updates"
    if [ "$mode" = ask ] && [ $gui -eq 0 ]; then "$HOME/.local/bin/custom-update" apply; else "$HOME/.local/bin/custom-update" apply --yes; fi
    fixes_rc=$?
fi

msgs=()
if [ $yay_rc -eq 0 ] && [ "${pending:-1}" -eq 0 ]; then msgs+=("System packages: already up to date.")
elif [ $yay_rc -eq 0 ]; then msgs+=("System packages: updated.")
elif [ "$mode" = ask ]; then msgs+=("System packages: not updated (you said no, or it failed; see the output above).")
else msgs+=("System packages: update failed (exit code $yay_rc). See the output above."); fi
[ $sysfix_rc -ne 0 ] && msgs+=("System fixes: installation failed (see the output above).")
[ $fixes_rc -ne 0 ] && msgs+=("Custom fixes: installation failed (see the output above).")
[ "$hypr_before" != "$(pacman -Q hyprland 2>/dev/null)" ] && [ $in_hypr -eq 1 ] && msgs+=("Hyprland was updated: log out and log in again to complete the update.")
[ "$plasma_before" != "$(pacman -Q plasma-workspace 2>/dev/null)" ] && [ $in_hypr -eq 0 ] && msgs+=("Plasma was updated: log out and log in again to complete the update.")
[ "$kernel_before" != "$(pacman -Q linux 2>/dev/null)" ] && msgs+=("The kernel was updated: restart the computer when convenient.")
# desktop check (only meaningful while Hyprland runs and before a Hyprland update takes effect; the login check after
# the next login covers the rest)
health_rc=0
if [ $in_hypr -eq 1 ] && [ "$hypr_before" = "$(pacman -Q hyprland 2>/dev/null)" ] && [ -x "$HOME/.local/bin/phoenix-check" ]; then
    health=$("$HOME/.local/bin/phoenix-check" health)
    health_rc=$?
    [ $health_rc -ne 0 ] && msgs+=("Desktop check: $health")
fi

echo
step "Summary"
printf '%s\n' "${msgs[@]}"
echo
if [ $gui -eq 1 ]; then
    # the shell shows the result (and a notification): no questions here
    for m in "${msgs[@]}"; do echo "@@msg $m"; done
    [ "$hypr_before" != "$(pacman -Q hyprland 2>/dev/null)" ] && [ $in_hypr -eq 1 ] && echo "@@relogin"
    [ "$kernel_before" != "$(pacman -Q linux 2>/dev/null)" ] && echo "@@reboot"
    [ $yay_rc -eq 0 ] && [ $sysfix_rc -eq 0 ] && [ $fixes_rc -eq 0 ] && [ $health_rc -eq 0 ] && exit 0
    exit 1
fi

if [ $yay_rc -eq 0 ] && [ $sysfix_rc -eq 0 ] && [ $fixes_rc -eq 0 ] && [ $health_rc -eq 0 ]; then
    notify-send -a "System update" "Update finished" "$(printf '%s\n' "${msgs[@]}")"
    # A timed-out `read -t` returns 142 (SIGALRM). Exit 0 explicitly, or kitty reports it as a failure.
    read -t 10 -n 1 -s -p "Closing in 10s. Press any key to keep this window open." && read -r -p $'\nPress Enter to close.'
    exit 0
else
    notify-send -a "System update" -u critical "Update needs attention" "$(printf '%s\n' "${msgs[@]}")"
    read -r -p "Press Enter to close."
fi
