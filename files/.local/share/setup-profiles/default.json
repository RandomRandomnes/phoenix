{
    "format": "end4-setup-profile",
    "version": 1,
    "name": "Default",
    "description": "Windows-style windows with title bars, an app grid, a still wallpaper and monochrome colors",
    "author": "RandomRandomnes",
    "look": "stock",
    "features": {
        "windowsStyle": true,
        "minimizeToDock": true,
        "wallpaperEngine": false,
        "resourceGraphs": false,
        "appGrid": true,
        "powerMenuKde": false,
        "claudeCodeAi": false,
        "updatesScript": true,
        "steamTray": false,
        "gameModeAuto": false,
        "autoDnd": true,
        "workspaceGroups": true,
        "wallpaperEngineCard": true,
        "deviceBatteries": true,
        "desktopSwitch": false
    },
    "settings": {
        "dock": {
            "enable": true
        },
        "appearance": {
            "palette": {
                "type": "scheme-monochrome"
            }
        },
        "bar": {
            "layouts": {
                "rightLayout": [
                    "sysTray",
                    "batteryIndicator",
                    "utilButtons",
                    "systemIcons",
                    "powerButton"
                ]
            }
        }
    },
    "wallpaper": "@default",
    "apps": []
}
