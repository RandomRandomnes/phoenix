#!/bin/bash
# Starts the Phoenix desktop (2026-10-08, ours). Run by the login screen (greetd) as the user who signed in;
# installed root-owned at /usr/local/bin/phoenix-session by `phoenix login-screen install`.
# The argument (the login screen's session choice) is remembered in ~/.config/desktop-session, the same file
# ~/.local/bin/switch-desktop and the tty1 autologin in ~/.bash_profile use.
# greetd reads /etc/profile and ~/.profile but not ~/.bashrc, where ~/.local/bin is put on PATH; the tty1 autologin got it
# from there. Without it the terminal (fish) and anything started by name can't find ~/.local/bin (claude, Phoenix's
# tools) (2026-10-09)
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
rm -f /var/lib/phoenix-greeter/theme/next-session 2>/dev/null   # switch-desktop's note for the login screen is used
case "${1:-}" in
    hyprland|plasma) mkdir -p "$HOME/.config" && echo "$1" > "$HOME/.config/desktop-session" ;;
esac
# Hyprland and Plasma print their start-up log as text; on the login screen's console that flashed on screen for a
# second after signing in (2026-10-12). It goes to a file instead (Hyprland keeps its own log as well).
mkdir -p "$HOME/.local/state/phoenix"
exec >"$HOME/.local/state/phoenix/session.log" 2>&1
if [ "${PHOENIX_AUTHENTICATED:-}" = 1 ]; then echo "$(date '+%F %T') session start: signed in at the login screen"
else echo "$(date '+%F %T') session start: no password yet (autologin), lock screen first"; fi
# Lock-screen sign-in (2026-10-15, `phoenix login-screen install --mode lock`): greetd's initial_session starts this once
# per boot WITHOUT a password. Then the desktop starts behind the lock screen: PHOENIX_LOCK_FIRST=1 makes the shell lock
# first and build everything else behind it, and Hyprland start with no working shortcuts until the lock is up.
# Only the login screen's own flag (PHOENIX_AUTHENTICATED=1, set by greeter.qml after the password) means "unlocked";
# anything else (missing, garbled) means lock first.
if [ "${PHOENIX_AUTHENTICATED:-}" = 1 ]; then
    unset PHOENIX_LOCK_FIRST
else
    if [ "$(cat "$HOME/.config/desktop-session" 2>/dev/null)" = "plasma" ]; then
        echo "KDE Plasma was the last desktop: it has no lock-screen start, so the full login screen takes over"
        exit 0
    fi
    export PHOENIX_LOCK_FIRST=1
    run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    rm -f "$run/phoenix-lock-up" "$run/phoenix-unlocked-once"
    # Watchdog, fail closed: if the lock screen isn't confirmed within 30 s, end the session; greetd then shows the full
    # login screen (initial_session only runs once per boot, so this can't loop).
    (
        for _ in $(seq 60); do [ -e "$run/phoenix-lock-up" ] && exit 0; sleep 0.5; done
        echo "$(date +%T) the lock screen didn't come up within 30 s: ending the session (the login screen takes over)"
        pkill -TERM -u "$(id -u)" -x Hyprland; sleep 5; pkill -KILL -u "$(id -u)" -x Hyprland
    ) &
fi
unset PHOENIX_AUTHENTICATED
if [ "$(cat "$HOME/.config/desktop-session" 2>/dev/null)" = "plasma" ] && [ -x /usr/bin/startplasma-wayland ]; then
    start=$SECONDS
    /usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
    # Plasma died right away -> Hyprland next time instead of a loop (same rule as ~/.bash_profile)
    (( SECONDS - start < 15 )) && echo hyprland > "$HOME/.config/desktop-session"
    exit
fi
exec start-hyprland
